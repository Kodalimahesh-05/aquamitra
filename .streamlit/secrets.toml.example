# AquaMitra Secret Configuration Template
# Copy this file to secrets.toml and update with your actual credentials for SQL Server Mode.

[database]
server = "localhost"
database = "AquaMitraDB"
username = "sa"
password = "YourStrongPassword123!"
driver = "ODBC Driver 18 for SQL Server"
trust_server_certificate = "yes"

[weather]
# Optional external weather API key (e.g. OpenWeatherMap or WeatherAPI)
api_key = ""
default_city = "Vijayawada"
default_lat = 16.5062
default_lon = 80.6480
